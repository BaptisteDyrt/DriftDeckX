{
  "name": "driftdeckx",
  "version": "1.0.12",
  "description": "Outil de sauvegarde de réglages pour CarX Drift Racing Online",
  "main": "electron.js",
  "author": "Baptiste Dayraut",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaptisteDyrt/DriftDeckX.git"
  },
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:all": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.baptistedayraut.driftdeckx",
    "productName": "DriftDeckX",
    "copyright": "© 2026 Baptiste Dayraut",
    "files": [
      "**/*",
      "!dist/**/*",
      "!.git/**/*",
      "!.github/**/*",
      "!assets/AppIcon.iconset/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/Logo.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "assets/Logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "dmg": {
      "title": "DriftDeckX",
      "background": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DriftDeckX-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}